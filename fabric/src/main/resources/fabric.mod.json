{
	"schemaVersion": 1,
	"id": "afkraft_companion",
	"provides": [
		"afkraft-companion"
	],
	"version": "${version}",
	"name": "AFKraft Companion",
	"description": "Lightweight companion mod for AFKraft that streams opt-in AFK container, player, and mobcap sphere snapshots in real time.",
	"authors": [
		"IKangreburguito"
	],
	"contact": {
		"homepage": "https://github.com/MARS42/afkraft-companion-mod",
		"sources": "https://github.com/MARS42/afkraft-companion-mod",
		"issues": "https://github.com/MARS42/afkraft-companion-mod/issues"
	},
	"license": "LicenseRef-PolyForm-Shield-1.0.0",
	"icon": "assets/afkraft_companion/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.mars4two.ikang.fabric.AFKraftCompanionFabric"
		],
		"client": [
			"com.mars4two.ikang.fabric.client.AFKraftCompanionFabricClient"
		]
	},
	"mixins": [
		"afkraft_companion.mixins.json",
		{
			"config": "afkraft_companion.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${fabric_mc_range}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}
